{
    "latex-workshop.latex.tools": [

        {
          "name": "latexmk",
          "command": "latexmk",
          "args": [
            "-synctex=1",
            "-interaction=nonstopmode",
            "-file-line-error",
            "-pdf",
            "-outdir=%OUTDIR%",
            "%DOC%"
          ],
          "env": {"TEXMFHOME": "C:/texlive/2023"}
        }
      ],
  "[java]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": true, // Optional: ensure spaces are used instead of tabs
      // "editor.detectIndentation": false // Optional: prevent VS Code from automatically detecting indentation from file content
  },
  "git.autofetch": true,
  "workbench.editorAssociations": {
    "*.pdf~main": "default"
  },
  "editor.minimap.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.tabCompletion": "on",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.tabSize": 2,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "remote.SSH.remotePlatform": {
    "basicServer": "linux"
  },
  "workbench.colorTheme": "Intellij Darcula Theme",


  //VIM SETTING
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 10,
  "vim.incsearch": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.highlightedyank.enable": true,
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "vim.handleKeys": {
    "<C-a>": true,
    "<C-x>": true,
    "<C-f>": false,
    "<C-=>": true,
    "<C-->": true
  },
  "vim.insertModeKeyBindings": [
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": ["<leader>", "y"],
      "commands": ["editor.action.clipboardCopyAction"]
    },
    {
      "before": ["<leader>", "p"],
      "commands": ["editor.action.clipboardPasteAction"]
    },
    {
      "before": [">"],
      "after": [">","g", "v"]
    },
    {
      "before": ["<"],
      "after": ["<","g", "v"]
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // QUALITY OF LIFE
    {
      "before": ["<leader>", "y"],
      "commands": ["editor.action.clipboardCopyAction"]
    },
    {
      "before": ["<leader>", "p"],
      "commands": ["editor.action.clipboardPasteAction"]
    },
    {
      "before": ["t","f"],
      "commands": ["editor.toggleFold"]
    },
    {
      "before": [">"],
      "after": [">",">"]
    },
    {
      "before": ["<"],
      "after": ["<","<"]
    },
    {
      "before": ["<C-up>"],
      "commands": ["editor.action.insertCursorAbove"]
    },
    {
      "before": ["<C-down>"],
      "commands": ["editor.action.insertCursorBelow"]
    },
    {
      "before": ["<leader>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "|"],
      "commands": ["workbench.action.splitEditorRight","workbench.action.focusLeftGroup",  "workbench.action.closeActiveEditor", "workbench.action.focusRightGroup"]
    },
    {
      "before": ["n"],
      "after": ["n","z","z"]
    },
    {
      "before": ["<c-a>"],
      "commands":["editor.emmet.action.incrementNumberByOne"]
    },
    {
      "before": ["<c-x>"],
      "commands":["editor.emmet.action.decrementNumberByOne"]
    },
    // FILE EXPLORER
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "F"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>","f","e"],
      "commands": ["workbench.files.action.focusFilesExplorer"]
    },
    // { THIS IS ACTUALLY SET IN THE VSCODE KEYBINDINGS
    //   "before": ["<c-n>"],
    //   "commands": ["workbench.action.toggleSidebarVisibility"]
    // },
    // LSP
    {
      "before": ["<leader>", "c", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["<leader>", "r", "n"],
      "commands": ["editor.action.rename"]
    }
    // NAVIGATION
    {
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"]
    },
    // { THIS IS ACTUALLY SET IN THE VSCODE KEYBINDINGS
    //   "before": ["<C-=>"],
    //   "commands": ["workbench.action.toggleMaximizeEditorGroup"]
    // },
    // {
    //   "before": ["<C-->"],
    //   "commands": ["workbench.action.evenEditorWidths"]
    // },
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.focusLeftGroup"]
    },
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.focusRightGroup"]
    },
    // { THIS IS ACTUALLY SET IN THE VSCODE KEYBINDINGS
    //   "before": ["<C-H>"],
    //   "commands": ["workbench.action.moveEditorToFirstGroup"]
    // },
    // {
    //   "before": ["<C-L>"],
    //   "commands": ["workbench.action.moveEditorToLastGroup"]
    // },
    {
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.terminal.focus"]
    },
    {
      "before": ["<leader>", "T"],
      "commands": ["workbench.action.closePanel"]
    },
    {
      "before": ["<leader>","c","a"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.showHover"]
    },
    // OTHER
    // {
    //   "before": ["K"],
    //   "commands": ["lineBreakInsert"],
    //   "silent": true
    // },
  ],
}